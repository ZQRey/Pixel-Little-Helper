<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#7f1d1d"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚨"
        android:textSize="54sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="УСТРОЙСТВО ЗАБЛОКИРОВАНО"
        android:textAlignment="center"
        android:textColor="#ffffff"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Pixel Anti-Theft · Режим розыска"
        android:textColor="#fecaca"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="#991b1b"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvLockMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="@string/lock_default_message"
            android:textColor="#ffffff"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#b91c1c" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Координаты GPS и данные сети непрерывно передаются на сервер безопасности организации."
            android:textColor="#fca5a5"
            android:textSize="12sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/etUnlockPin"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="#ffffff"
        android:gravity="center"
        android:hint="Код разблокировки"
        android:inputType="numberPassword"
        android:maxLength="8"
        android:padding="12dp"
        android:textColor="#0f172a"
        android:textColorHint="#94a3b8"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnSubmitPin"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#ffffff"
        android:text="Разблокировать"
        android:textColor="#991b1b"
        android:textStyle="bold" />

</LinearLayout>

