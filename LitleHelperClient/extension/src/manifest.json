{
  "manifest_version": 3,
  "name": "PixelHelper Web Guard",
  "version": "1.0.0",
  "description": "Интерактивная защита от фишинга и опасных сайтов",
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "webNavigation",
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
