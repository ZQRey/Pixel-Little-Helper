<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="PixelHelper" Language="1049" Codepage="1251" Version="1.2.21" Manufacturer="PixelHelper" UpgradeCode="0C2B80D1-52E0-4931-8F48-FBB031A89A55">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" />
    <MajorUpgrade DowngradeErrorMessage="Установлена более новая версия PixelHelper." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="SERVERURL" Secure="yes" />
    <Property Id="EXISTINGSERVERURL">
      <RegistrySearch Id="FindServerUrl" Root="HKLM" Key="Software\PixelHelper" Name="ServerUrl" Type="raw" Win64="yes" />
    </Property>
    <SetProperty Id="SERVERURL" Action="UseExistingServerUrl" Value="[EXISTINGSERVERURL]" After="AppSearch">NOT SERVERURL AND EXISTINGSERVERURL</SetProperty>
    <SetProperty Id="SERVERURL" Action="UseDefaultServerUrl" Value="http://helper.gp1.loc" After="UseExistingServerUrl">NOT SERVERURL</SetProperty>
    <Condition Message="Укажите адрес вида http://helper.gp1.loc: прямые слеши, без пробелов и запятых.">Installed OR ((SERVERURL &lt;&lt; "http://" OR SERVERURL &lt;&lt; "https://") AND NOT (SERVERURL &gt;&lt; " ") AND NOT (SERVERURL &gt;&lt; "\") AND NOT (SERVERURL &gt;&lt; ",") AND SERVERURL &lt;&gt; "http://" AND SERVERURL &lt;&gt; "https://")</Condition>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder"><Directory Id="INSTALLFOLDER" Name="PixelHelper">
        <Component Id="MainExecutableComponent" Guid="96F581E4-391C-490F-B3E7-2CD0B03BAC75" Win64="yes">
          <File Id="MainExecutable" Source="$(var.PublishDir)\PixelHelper.exe" KeyPath="yes">
            <Shortcut Id="StartMenuLink" Directory="StartMenuFolder" Name="PixelHelper" WorkingDirectory="INSTALLFOLDER" Advertise="yes" />
          </File>
          <ServiceInstall Id="InstallUpdater" Name="PixelHelperUpdater" DisplayName="PixelHelper — обновления" Description="Проверка и установка подписанных обновлений клиента PixelHelper." Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Arguments="--update-service" />
          <ServiceControl Id="ControlUpdater" Name="PixelHelperUpdater" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
          <RemoveFolder Id="RemoveStartMenu" Directory="StartMenuFolder" On="uninstall" />
        </Component>
      </Directory></Directory>
      <Directory Id="CommonAppDataFolder"><Directory Id="ProgramDataShortcut" Name="PixelHelper">
        <Component Id="GlobalShortcut" Guid="6EF29E6E-26B8-49CF-9B6E-6E2AEBDCA86B" Win64="yes">
          <Shortcut Id="ProgramDataLink" Name="PixelHelper" Target="[INSTALLFOLDER]PixelHelper.exe" WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveShortcutDir" On="uninstall" />
          <RegistryValue Root="HKLM" Key="Software\PixelHelper" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory></Directory>

      <Directory Id="ProgramMenuFolder"><Directory Id="StartMenuFolder" Name="PixelHelper" /></Directory>
    </Directory>
      <DirectoryRef Id="INSTALLFOLDER">
        <Component Id="MachineStartup" Guid="4E44554C-1C23-4CB0-9AF6-BC19F339990A" Win64="yes">
          <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="PixelHelper" Type="string" Value="&quot;[INSTALLFOLDER]PixelHelper.exe&quot;" KeyPath="yes" />
        </Component>
        <Component Id="ServerConnection" Guid="B3CF3359-C01D-48FC-95C2-111DCBEE9B6F" Win64="yes">
          <RegistryValue Root="HKLM" Key="Software\PixelHelper" Name="ServerUrl" Type="string" Value="[SERVERURL]" KeyPath="yes" />
        </Component>
      </DirectoryRef>
    <Feature Id="Complete" Title="PixelHelper" Level="1">
      <ComponentGroupRef Id="PublishedFiles" />
      <ComponentRef Id="MainExecutableComponent" />
      <ComponentRef Id="GlobalShortcut" />
      <ComponentRef Id="ServerConnection" />
      <ComponentRef Id="MachineStartup" />
    </Feature>
    <CustomAction Id="CleanUserProfiles" FileKey="MainExecutable" ExeCommand="--cleanup-machine" Execute="deferred" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="CleanUserProfiles" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>
    <UI>
      <TextStyle Id="Normal" FaceName="Tahoma" Size="9" />
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="ExitDialog" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return">1</Publish>
      <Property Id="DefaultUIFont" Value="Normal" />
      <Dialog Id="ServerAddressDlg" Width="370" Height="210" Title="Установка PixelHelper" NoMinimize="yes">
        <Control Id="Title" Type="Text" X="20" Y="20" Width="330" Height="20" Text="Подключение помощника к серверу" />
        <Control Id="Label" Type="Text" X="20" Y="55" Width="330" Height="30" Text="Укажите адрес сервера, например http://helper.gp1.loc" />
        <Control Id="ServerUrl" Type="Edit" X="20" Y="90" Width="330" Height="18" Property="SERVERURL" />
        <Control Id="Note" Type="Text" X="20" Y="120" Width="330" Height="30" Text="Помощник запустится автоматически. Адрес применяется ко всем пользователям. Ключ создаётся автоматически." />
        <Control Id="Install" Type="PushButton" X="190" Y="175" Width="75" Height="23" Default="yes" Text="Установить">
          <Publish Event="EndDialog" Value="Return">(SERVERURL &lt;&lt; "http://" OR SERVERURL &lt;&lt; "https://") AND NOT (SERVERURL &gt;&lt; " ") AND NOT (SERVERURL &gt;&lt; "\") AND NOT (SERVERURL &gt;&lt; ",") AND SERVERURL &lt;&gt; "http://" AND SERVERURL &lt;&gt; "https://"</Publish>
          <Condition Action="disable">NOT ((SERVERURL &lt;&lt; "http://" OR SERVERURL &lt;&lt; "https://") AND NOT (SERVERURL &gt;&lt; " ") AND NOT (SERVERURL &gt;&lt; "\") AND NOT (SERVERURL &gt;&lt; ",") AND SERVERURL &lt;&gt; "http://" AND SERVERURL &lt;&gt; "https://")</Condition>
          <Condition Action="enable">(SERVERURL &lt;&lt; "http://" OR SERVERURL &lt;&lt; "https://") AND NOT (SERVERURL &gt;&lt; " ") AND NOT (SERVERURL &gt;&lt; "\") AND NOT (SERVERURL &gt;&lt; ",") AND SERVERURL &lt;&gt; "http://" AND SERVERURL &lt;&gt; "https://"</Condition>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="275" Y="175" Width="75" Height="23" Cancel="yes" Text="Отмена"><Publish Event="EndDialog" Value="Exit">1</Publish></Control>
      </Dialog>
      <Dialog Id="InstallProgressDlg" Width="370" Height="120" Title="PixelHelper" Modeless="yes">
        <Control Id="Label" Type="Text" X="20" Y="20" Width="330" Height="20" TabSkip="no" Text="Применение изменений…" />
        <Control Id="Progress" Type="ProgressBar" X="20" Y="55" Width="330" Height="15"><Subscribe Event="SetProgress" Attribute="Progress" /></Control>
      </Dialog>

      <InstallUISequence>
        <Show Dialog="ServerAddressDlg" Before="InstallProgressDlg">NOT Installed AND NOT REMOVE</Show>
        <Show Dialog="InstallProgressDlg" Before="ExecuteAction" />

      </InstallUISequence>
    </UI>
    <UIRef Id="WixUI_Common" />
  </Product>
</Wix>
